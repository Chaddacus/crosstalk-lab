# Copy to .env (gitignored). The key stays in the local server process; the browser never sees it.
# Preset: typesafe | openrouter | compat
CROSSTALK_PRESET=typesafe
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
# compat preset: any server that speaks POST /v1/systemone (for example a local Kev or Laya server)
CROSSTALK_COMPAT_URL=
CROSSTALK_COMPAT_KEY=
# Model override. Defaults: typesafe -> jev-1.13.0, openrouter -> typesafe/jev-1.13
CROSSTALK_MODEL=
# Spend cap per server process, in USD
CROSSTALK_BUDGET_USD=0.50
CROSSTALK_PORT=8787
