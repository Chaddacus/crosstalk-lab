# Copy to .env (gitignored). The key stays in the local server process; the browser never sees it.
# Preset: typesafe | openrouter | compat
CROSSTALK_PRESET=typesafe
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
# compat preset: any server that speaks POST /v1/systemone (for example a local Kev or Laya server)
CROSSTALK_COMPAT_URL=
CROSSTALK_COMPAT_KEY=
# Model override. Defaults: typesafe -> jev-1.13.0, openrouter -> typesafe/jev-1.13
CROSSTALK_MODEL=
# Spend cap per server process, in USD
CROSSTALK_BUDGET_USD=0.50
CROSSTALK_PORT=8787
# Web origins allowed to call the local server (comma list). Default: the Vite dev server on 127.0.0.1:5173 and localhost:5173
CROSSTALK_WEB_ORIGINS=
# Requests per minute to the upstream (default 600, half of the documented 1,200)
CROSSTALK_RPM=
# Total time for one upstream call, retries included, in ms (default 45000; the browser gives up at 60000)
CROSSTALK_DEADLINE_MS=
# Response cache root (default .cache/responses; one folder per upstream)
CROSSTALK_CACHE_DIR=
