{
  "name": "crosstalk-lab",
  "version": "0.1.0",
  "private": true,
  "description": "See which options a typed-decision router confuses, rewrite their wording, and prove the fix on a sealed test set.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "demo": "vite build && vite preview --port 4173 --strictPort --open",
    "live": "concurrently -k -n server,web -c cyan,magenta \"tsx server/main.ts\" \"vite\"",
    "server": "tsx server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/eval.ts",
    "freeze": "tsx scripts/freeze.ts",
    "fetch-spec": "tsx scripts/fetch-spec.ts",
    "build-catalog": "tsx scripts/build-catalog.ts",
    "export": "tsx scripts/export.ts",
    "fixtures": "tsx scripts/demo-fixtures.ts",
    "lint:data": "tsx scripts/lint-data.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "d3-array": "3.2.4",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "motion": "13.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-array": "3.2.2",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "hono": "4.13.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
